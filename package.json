{
  "name": "svelte5-devtools",
  "version": "0.1.0",
  "description": "Browser devtools extension for inspecting Svelte 5 applications",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:panel": "vite build -w --mode development",
    "dev:agent": "rollup -c -w",
    "build": "vite build && rollup -c",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --conditions=browser scripts/test-tree.js && node --conditions=browser scripts/test-agent.js && node --conditions=browser scripts/test-plugin.js && node --conditions=browser scripts/test-integration.js",
    "playground": "vite --config playground/vite.config.js"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.5",
    "@types/chrome": "^0.1.30",
    "jsdom": "^29.1.1",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.52.5",
    "svelte": "^5.56.9",
    "svelte-check": "^4.4.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
